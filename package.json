{
  "name": "cf-ai-trippy",
  "version": "0.1.0",
  "private": true,
  "description": "Trippy — an AI agent that plans and revises personalised trip itineraries, built on Cloudflare",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/ test/",
    "format": "oxfmt --write .",
    "check": "oxfmt --check . && oxlint src/ test/ && tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.160",
    "@cloudflare/ai-chat": "^0.12.2",
    "agents": "^0.31.0",
    "ai": "^7.0.155",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true,
    "core-js-pure": false
  }
}
